[codespell]
# codespell config: catches common English typos in markdown sources.
# See https://github.com/codespell-project/codespell

# Where to look. Avoid binary assets, build output, and the git/CI plumbing.
skip = *.lock,*.png,*.jpg,*.jpeg,*.gz,*.tar,*.zip,*.ico,public,resources,.git,.github/dependabot.yml

# Whitelist false positives:
#   ru = "Russian" (locale code, not "run")
#   nd = letters that codespell flags but appear in our content as initials
ignore-words-list = ru,nd
